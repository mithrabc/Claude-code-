# Copy to .env and adjust. All values are optional.

# Network the server binds to.
HOST=0.0.0.0
PORT=4517

# Shared secret. When set, browsers must open the UI with ?token=THE_TOKEN
# and the WebSocket is refused without it. Leave empty ONLY on a trusted LAN.
AUTH_TOKEN=

# Directory Claude Code operates in (defaults to the process working dir).
WORKSPACE=/path/to/your/project

# Extra directories offered in the web UI's workspace switcher. Separate with
# the OS path delimiter (";" on Windows, ":" on POSIX), commas, or newlines.
# WORKSPACE above is always included.
WORKSPACES=/path/to/project-a:/path/to/project-b

# Allow the switcher to open an arbitrary typed path (that exists). Off by
# default so the browser can only reach the directories listed above.
ALLOW_ANY_WORKSPACE=0

# Claude Code CLI binary and optional model override.
CLAUDE_BIN=claude
CLAUDE_MODEL=

# Permission mode for the headless session: acceptEdits | bypassPermissions | plan
# There is no human at the terminal, so tool prompts must resolve automatically.
PERMISSION_MODE=acceptEdits

# Set to 1 to use the built-in mock backend (no real CLI calls) for UI dev.
MOCK=0

# On startup the server prints a scannable QR code of the phone URL.
# Set QR=0 to disable it (e.g. terminals that mangle block characters).
QR=1
